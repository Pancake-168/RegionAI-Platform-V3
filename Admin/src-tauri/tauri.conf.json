{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "regionaiv3",
  "version": "0.1.0",
  "identifier": "com.regionaiv3.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "bin/WebView2Loader.dll": "bin/WebView2Loader.dll"
    },
    "icon": ["icons/icon.ico"]
  }
}
